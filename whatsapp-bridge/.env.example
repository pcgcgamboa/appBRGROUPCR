PORT=3001
# Token secreto que debe enviar cada llamada en el header "x-api-key". Genere uno propio (por
# ejemplo con `openssl rand -hex 32`) y cárguelo también como el secret WHATSAPP_BRIDGE_API_KEY
# de Supabase — deben ser el mismo valor en ambos lados.
BRIDGE_API_KEY=
# Código de país que se antepone cuando un teléfono llega sin él (números locales de 8 dígitos).
CODIGO_PAIS_DEFECTO=506
