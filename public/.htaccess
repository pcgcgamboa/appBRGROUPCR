RewriteEngine On

# Forzar HTTPS solo en el dominio publico (el dominio tecnico de OVH no tiene certificado)
RewriteCond %{HTTP_HOST} ^app\.brgroupcr\.com$ [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^ https://app.brgroupcr.com%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]
